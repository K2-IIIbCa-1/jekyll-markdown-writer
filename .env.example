# Copy this file to .env. Never commit the real values.
# Leave blank to use the directory two levels above this tool as the Jekyll root.
JEKYLL_ROOT=
JEKYLL_WRITER_NAME=Jekyll Writer
JEKYLL_SITE_NAME=Jekyll Blog
JEKYLL_DRAFTS_DIRECTORY=_drafts
JEKYLL_POSTS_DIRECTORY=_posts
JEKYLL_WRITER_EXCLUDED_DIRECTORIES=demo,preset
JEKYLL_MEDIA_DIRECTORY=images
JEKYLL_POST_URL_PREFIX=/posts
JEKYLL_DEFAULT_TOC=true
JEKYLL_DEFAULT_COMMENTS=true
JEKYLL_COMMAND=
JEKYLL_PORT=4000
JEKYLL_PREVIEW_URL=http://127.0.0.1:4000
BLOG_WRITER_PORT=4170
JEKYLL_GIT_ENABLED=true

# Optional AI description generation defaults.
AI_PROVIDER=openai
AI_MODEL=
AI_API_KEY=
AI_ENDPOINT=

# Optional Cloudflare R2 image upload.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_JURISDICTION=default
R2_REGION=auto
R2_PUBLIC_BASE_URL=
# Leave blank. It is derived from Account ID + jurisdiction.
R2_ENDPOINT=
